# SOURCE_URL=https://zh.wikipedia.org/wiki/%E5%A4%A7%E7%86%8A%E7%8C%AB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHAT_MODEL=gpt-5-nano
TEMPERATURE=0.0
TAVILY_RESULTS=3
